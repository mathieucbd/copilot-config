// Merge into VS Code USER settings (Preferences: Open User Settings (JSON)),
// %APPDATA%\Code\User\settings.json [SOURCES 7.7]. Copilot and chat keys only.
// Do not paste over existing keys: README "Merge the settings snippet".
// Bracketed references point to docs/SOURCES.md in copilot-config. Org policy overrides any key marked
// "policy" [SOURCES §4, S14].
{
  // No global tool auto-approve. Default false. Policy: ChatToolsAutoApprove. [§4]
  "chat.tools.global.autoApprove": false,

  // Every terminal command asks, including the built-in allow-list of
  // "common read-only commands" that otherwise run automatically.
  // Default true. Policy: ChatToolsTerminalEnableAutoApprove. [§4]
  "chat.tools.terminal.enableAutoApprove": false,

  // Backstop, used only if the key above is ever turned back on: these always
  // ask. A false rule requires approval; it does not block. Repeats the
  // documented default deny rules, then adds remote, merge and network commands.
  // No policy. [§4]
  "chat.tools.terminal.autoApprove": {
    "rm": false,
    "rmdir": false,
    "del": false,
    "kill": false,
    "curl": false,
    "wget": false,
    "eval": false,
    "chmod": false,
    "chown": false,
    "/^Remove-Item\\b/i": false,
    "/^git\\s+(push|pull|fetch|merge|rebase|remote|reset)\\b/": false,
    "/^(ssh|scp|sftp)\\b/": false,
    "/^(Invoke-WebRequest|Invoke-RestMethod|iwr|irm)\\b/i": false
  },

  // Every file edit shows a diff and asks before it is applied. Agent Host
  // sessions have no pending keep/undo state, so this is the only pre-write
  // gate [4.1]. Default {}. No policy. The catch-all "**/*": false is an
  // INFERENCE from the documented glob -> false behaviour; README test E1. [§4]
  "chat.tools.edits.autoApprove": {
    "**/*": false
  },

  // Never auto-keep pending edits (extension-host / Local sessions). Default 0.
  // No policy. [§4]
  "chat.editing.autoAcceptDelay": 0,

  // New sessions start at Manual permissions. Default "default".
  // Experimental. No policy of its own. [§4]
  "chat.permissions.default": "default",

  // Keep the LLM-judge permission level hidden. Default false (Stable).
  // Experimental. [§4 controls table]
  "chat.assistedPermissions.enabled": false,

  // Tools that always ask and never offer "allow for session/workspace/always".
  // Covers paths that reach the same outcomes as the terminal: tasks, notebook
  // cells, VS Code commands (e.g. Git: Push), extension installs, web fetch.
  // Experimental. Policy: ChatToolsEligibleForAutoApproval.
  // CONFLICT on value type (default shown as [], documented as tool -> false)
  // and tool IDs unverified in the Copilot harness [7.3, 7.4]; README test T5.
  "chat.tools.eligibleForAutoApproval": {
    "execute/runInTerminal": false,
    "execute/createAndRunTask": false,
    "execute/runNotebookCell": false,
    "vscode/runCommand": false,
    "vscode/installExtension": false,
    "web/fetch": false
  },

  // If terminal sandboxing is ever turned on, sandboxed commands would be
  // auto-approved (default true), bypassing enableAutoApprove: false.
  // Preview. Policy: ChatAgentSandboxAllowAutoApprove. [§4]
  "chat.agent.sandbox.allowAutoApprove": false,

  // Remove the Claude harness from the Session Target list. It has its own
  // permission modes, including "Edit automatically", outside the settings
  // above. Defaults true. Policy: Claude3PIntegration (both keys). [7.5]
  "github.copilot.chat.claudeAgent.enabled": false,
  // Experimental. [7.5]
  "chat.agentHost.claudeAgent.enabled": false,

  // Commit-message text generated by the Source Control sparkle button.
  // Shapes the message text only; harness-commit remains the path for splitting
  // changes into commits. Experimental. Default []. [7.11]
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Format: [TAG] - Short summary. Bullet points below only if needed. Tags: [INIT] [FEAT] [FIX] [REFACTOR] [CHORE] [DOCS]. No trailers, no tool attribution, no emoji: no Co-authored-by, no session IDs, no generated-with footer."
    }
  ]
}
